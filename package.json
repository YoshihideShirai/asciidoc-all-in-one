{
  "name": "asciidoc-local-preview",
  "displayName": "AsciiDoc Zero-Network Preview",
  "description": "Local AsciiDoc preview for VS Code with MathJax, Mermaid, PlantUML, and Kroki-compatible diagrams.",
  "version": "0.5.1",
  "publisher": "YoshihideShirai",
  "license": "MIT",
  "icon": "media/extension-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/YoshihideShirai/asciidoc-local-preview-vscode.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "activationEvents": [
    "onLanguage:asciidoc",
    "onCommand:asciidoc-local-preview.openPreview",
    "onCommand:asciidoc-local-preview.refreshPreview",
    "onCommand:asciidoc-local-preview.toggleBold",
    "onCommand:asciidoc-local-preview.toggleItalic",
    "onCommand:asciidoc-local-preview.toggleMonospace",
    "onCommand:asciidoc-local-preview.insertLink",
    "onCommand:asciidoc-local-preview.insertHeading",
    "onCommand:asciidoc-local-preview.insertUnorderedList"
  ],
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "asciidoc-local-preview.openPreview",
        "title": "Open Zero-Network Preview",
        "category": "AsciiDoc",
        "icon": "$(open-preview)"
      },
      {
        "command": "asciidoc-local-preview.refreshPreview",
        "title": "Refresh Preview",
        "category": "AsciiDoc"
      },
      {
        "command": "asciidoc-local-preview.toggleBold",
        "title": "Bold",
        "category": "AsciiDoc"
      },
      {
        "command": "asciidoc-local-preview.toggleItalic",
        "title": "Italic",
        "category": "AsciiDoc"
      },
      {
        "command": "asciidoc-local-preview.toggleMonospace",
        "title": "Monospace",
        "category": "AsciiDoc"
      },
      {
        "command": "asciidoc-local-preview.insertLink",
        "title": "Insert Link",
        "category": "AsciiDoc"
      },
      {
        "command": "asciidoc-local-preview.insertHeading",
        "title": "Insert Section Heading",
        "category": "AsciiDoc"
      },
      {
        "command": "asciidoc-local-preview.insertUnorderedList",
        "title": "Insert Unordered List",
        "category": "AsciiDoc"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "asciidoc-local-preview.openPreview",
          "when": "resourceLangId == asciidoc || resourceExtname == .adoc || resourceExtname == .ad || resourceExtname == .asciidoc || resourceExtname == .asc",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "asciidoc-local-preview.openPreview",
          "when": "resourceLangId == asciidoc || resourceExtname == .adoc || resourceExtname == .ad || resourceExtname == .asciidoc || resourceExtname == .asc",
          "group": "navigation"
        },
        {
          "command": "asciidoc-local-preview.toggleBold",
          "when": "editorLangId == asciidoc || resourceExtname == .adoc || resourceExtname == .ad || resourceExtname == .asciidoc || resourceExtname == .asc",
          "group": "1_modification"
        },
        {
          "command": "asciidoc-local-preview.toggleItalic",
          "when": "editorLangId == asciidoc || resourceExtname == .adoc || resourceExtname == .ad || resourceExtname == .asciidoc || resourceExtname == .asc",
          "group": "1_modification"
        },
        {
          "command": "asciidoc-local-preview.toggleMonospace",
          "when": "editorLangId == asciidoc || resourceExtname == .adoc || resourceExtname == .ad || resourceExtname == .asciidoc || resourceExtname == .asc",
          "group": "1_modification"
        },
        {
          "command": "asciidoc-local-preview.insertLink",
          "when": "editorLangId == asciidoc || resourceExtname == .adoc || resourceExtname == .ad || resourceExtname == .asciidoc || resourceExtname == .asc",
          "group": "1_modification"
        },
        {
          "command": "asciidoc-local-preview.insertHeading",
          "when": "editorLangId == asciidoc || resourceExtname == .adoc || resourceExtname == .ad || resourceExtname == .asciidoc || resourceExtname == .asc",
          "group": "1_modification"
        },
        {
          "command": "asciidoc-local-preview.insertUnorderedList",
          "when": "editorLangId == asciidoc || resourceExtname == .adoc || resourceExtname == .ad || resourceExtname == .asciidoc || resourceExtname == .asc",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "AsciiDoc Zero-Network Preview",
      "properties": {
        "asciidoc-local-preview.allowedPreviewHosts": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "items": {
            "type": "string",
            "pattern": "^(https?://)?[^\\s*/?#]+$"
          },
          "markdownDescription": "Hosts that remote preview images may load from. Entries may be host names like `example.com`; an `http` or `https` scheme may be included to restrict the allowed scheme. Empty by default, so remote images are blocked."
        },
        "asciidoc-local-preview.previewWidth": {
          "type": "string",
          "default": "default",
          "scope": "resource",
          "enum": [
            "default",
            "window"
          ],
          "enumDescriptions": [
            "Use the bundled Antora-style reading width.",
            "Expand the document preview to the full Webview width."
          ],
          "markdownDescription": "Controls the maximum width of the document preview. Use `default` for the bundled Antora-style reading width, or `window` to expand the document to the Webview width."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run clean && npm run compile && npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --external:@asciidoctor/core --outfile=out/extension.js --sourcemap",
    "clean": "rm -rf out",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "verify:package-files": "vsce ls --no-dependencies | node scripts/verify-package-files.js",
    "verify:no-network": "node scripts/verify-no-network.js",
    "pretest": "npm run compile && npm run bundle && npm run lint && npm run verify:no-network && npm run verify:package-files",
    "lint": "eslint src",
    "test": "vscode-test",
    "prepackage:vsix": "npm run build && npm run verify:package-files",
    "package:vsix": "vsce package --out asciidoc-local-preview-${npm_package_version}.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@asciidoctor/core": "^3.0.4",
    "asciidoctor-emoji": "^0.5.0",
    "asciidoctor-kroki-embedded": "git+https://github.com/YoshihideShirai/asciidoctor-kroki-embedded.git",
    "asciidoctor-numbered-captions": "git+https://github.com/YoshihideShirai/asciidoctor-numbered-captions.git#v1.0.0",
    "mathjax": "^4.1.2"
  }
}
